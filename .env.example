# Supabase — public keys only (safe for Vite frontend build)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL (SEO, sitemap, OG tags)
VITE_SITE_URL=https://svenskaspraket.com

# ---------------------------------------------------------------------------
# Hostinger build — set these in the Hostinger environment panel (build step)
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are required for admin panel
# Do NOT add SUPABASE_SERVICE_ROLE_KEY to Hostinger
# ---------------------------------------------------------------------------

# Seed / import scripts (local machine only — never commit .env)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database password for schema apply (Project Settings → Database → URI password)
# Or paste the full connection string:
# DATABASE_URL=postgresql://postgres.your-ref:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_DB_REGION=eu-central-1

# Content import guard — see scripts/import/README.md
# IMPORT_ENV=staging
# IMPORT_ALLOW_PRODUCTION=yes

# Optional: Supabase CLI linked project (for `supabase db push` / type generation)
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_ACCESS_TOKEN=your-personal-access-token

# ---------------------------------------------------------------------------
# Security reminders
# ---------------------------------------------------------------------------
# - Do NOT put SUPABASE_SERVICE_ROLE_KEY in GitHub Actions vars exposed to the frontend build.
# - Do NOT commit .env — only .env.example belongs in git.
# - Create the first admin manually in Supabase dashboard (see supabase/README.md).
